services:
  - type: web
    name: pepperstone-ctrader-bot
    env: node
    buildCommand: npm install
    startCommand: node server.js
    envVars:
      - key: PORT
        value: 3000
      - key: CTRADER_CLIENT_ID
        sync: false
      - key: CTRADER_CLIENT_SECRET
        sync: false
      - key: CTRADER_REDIRECT_URI
        value: https://quantum-edge-pro-bot.onrender.com/oauth/callback
    plan: free
