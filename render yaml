services:
  - type: web
    name: quantum-edge-pro-bot
    env: node
    buildCommand: npm install
    startCommand: node server.js
    envVars:
      - key: PORT
        value: 3000
      - key: CTRADER_CLIENT_ID
        value: YOUR_CLIENT_ID_FROM_CTRADER
      - key: CTRADER_CLIENT_SECRET
        value: YOUR_CLIENT_SECRET_FROM_CTRADER
      - key: REDIRECT_URI
        value: https://quantum-edge-pro-bot.onrender.com/oauth/callback
    plan: free
